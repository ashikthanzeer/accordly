# ==============================================================================
# Accordly — Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. VERCEL FRONTEND CONFIGURATION
# ------------------------------------------------------------------------------
# Set on Vercel Project Settings > Environment Variables:

# URL of the Render backend Web Service (enables Next.js /api rewrites)
# e.g. https://accordly-api.onrender.com
BACKEND_API_URL=

# Public domain of the Vercel frontend application (used for client links)
# e.g. https://accordly.vercel.app
NEXT_PUBLIC_APP_URL=https://accordly.vercel.app


# ------------------------------------------------------------------------------
# 2. RENDER BACKEND WEB SERVICE CONFIGURATION
# ------------------------------------------------------------------------------
# Set on Render Dashboard > Environment:

# NeonDB Pooled Connection String (for runtime database queries)
# e.g. postgresql://user:pass@ep-pooler.c-8.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL=

# NeonDB Direct Connection String (for schema push and migrations)
# e.g. postgresql://user:pass@ep-direct.c-8.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DIRECT_URL=

# Render Persistent Disk Storage Path (Optional)
# Attach a Persistent Disk mounted at /var/data; uploads stored under /var/data/uploads.
# If STORAGE_DIR is omitted or unwritable, Accordly automatically falls back to ./uploads/documents or os.tmpdir()/accordly-uploads.
STORAGE_DIR=/var/data/uploads

# Public frontend domain (ensures review links generated on Render point to Vercel)
# e.g. https://accordly.vercel.app
NEXT_PUBLIC_APP_URL=https://accordly.vercel.app

# PayPal Sandbox API Configuration
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# PayPal Webhook ID (obtained from PayPal Developer Dashboard webhook registration)
# Registered Webhook URL must be: https://YOUR-RENDER-SERVICE.onrender.com/api/webhooks/paypal
PAYPAL_WEBHOOK_ID=

# AI Scope Classifier & Extraction Engine
# Supported providers: 'gemini', 'openai', or 'mock' (defaults to 'mock' if keys empty)
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_MODEL=gemini-2.0-flash

# Optional CORS Allowed Origins (if direct browser-to-backend access is ever needed)
CORS_ALLOWED_ORIGINS=https://accordly.vercel.app,http://localhost:3000
