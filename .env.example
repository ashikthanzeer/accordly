# ==============================================================================
# Accordly — Environment Configuration
# ==============================================================================

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/accordly?schema=public"

# PayPal Configuration (Sandbox by default)
# Supported environments: 'sandbox' or 'live'
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Sandbox: https://api-m.sandbox.paypal.com | Live: https://api-m.paypal.com
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# AI Provider Configuration (Optional: defaults to 'mock' if keys not provided)
# Supported providers: 'gemini', 'openai', or 'mock'
AI_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_MODEL=gemini-1.5-flash

# Application Base URL (Used for generating client review links and webhook verification)
NEXT_PUBLIC_APP_URL=http://localhost:3000
